  <worksheets>
    <worksheet name='Delivery vs Review Score'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Average Review Score: On-Time vs Late Deliveries</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders+' name='federated.01itm3d0g7ykz314scf8z0h90z3k' />
          </datasources>
          <datasource-dependencies datasource='federated.01itm3d0g7ykz314scf8z0h90z3k'>
            <column-instance column='[review_score]' derivation='Avg' name='[avg:review_score:qk]' pivot='key' type='quantitative' />
            <column caption='Is Late Delivery' datatype='boolean' name='[is_late_delivery]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='On Time' />
                <alias key='true' value='Late' />
              </aliases>
            </column>
            <column-instance column='[is_late_delivery]' derivation='None' name='[none:is_late_delivery:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_status]' derivation='None' name='[none:order_status:nk]' pivot='key' type='nominal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Review Score' datatype='integer' name='[review_score]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.01itm3d0g7ykz314scf8z0h90z3k].[none:order_status:nk]'>
            <groupfilter function='member' level='[none:order_status:nk]' member='&quot;delivered&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.01itm3d0g7ykz314scf8z0h90z3k].[none:order_status:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.01itm3d0g7ykz314scf8z0h90z3k].[avg:review_score:qk]' value='n#,##0.00;-#,##0.00' />
          </style-rule>
          <style-rule element='label'>
            <format attr='text-format' field='[federated.01itm3d0g7ykz314scf8z0h90z3k].[avg:review_score:qk]' value='' />
          </style-rule>
        </style>
