            <column caption='Late Delivery Rate' datatype='real' name='[Calculation_1523494975479812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [is_late_delivery] THEN 1&#10;    ELSE 0&#10;    END&#10;)&#10;/&#10;SUM(&#10;    IF NOT ISNULL([order_delivered_customer_date]) THEN 1&#10;    ELSE 0&#10;    END&#10;)' />
